CODING_EXECUTOR_TOKEN=replace-with-at-least-32-random-characters
CODING_EXECUTOR_PUBLIC_URL=http://WINDOWS_LAN_IP:8765/mcp
CODING_EXECUTOR_ALLOWED_HOSTS=WINDOWS_LAN_IP:8765,localhost:8765,127.0.0.1:8765
CODING_EXECUTOR_PORT=8765
CODING_EXECUTOR_BIND=0.0.0.0
CODING_REPOSITORY_ROOT=/repos
CODING_TASK_ROOT=/tasks
CODING_REPOSITORY_HOST_PATH=/path/to/coding-agent/repos
CODING_TASK_HOST_PATH=/path/to/coding-agent/tasks
CODING_UID=1000
CODING_GID=1000
CODING_COMMAND_TIMEOUT_SECONDS=300
CODING_MAX_OUTPUT_BYTES=65536
