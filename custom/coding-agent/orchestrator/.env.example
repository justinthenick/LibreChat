# Explicit provider and exact model; neither has a default.
CODING_OPENHANDS_PROVIDER=chatgpt_subscription
CODING_OPENHANDS_MODEL=gpt-5.6-sol

CODING_OPENHANDS_EXECUTOR_URL=http://127.0.0.1:8765/mcp
CODING_OPENHANDS_SCRATCH_ROOT=/home/user/coding-agent/openhands-scratch
# Inject the executor credential securely at runtime.
CODING_EXECUTOR_TOKEN=
