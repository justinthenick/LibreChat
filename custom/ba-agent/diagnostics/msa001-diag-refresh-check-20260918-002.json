{
  "schema": 1,
  "name": "Verify BA diagnostic worker refresh path",
  "checks": [
    {
      "type": "tail",
      "label": "Recent BA scheduler log",
      "path": "custom/ba-agent/automation/scheduler.log",
      "lines": 200
    },
    {
      "type": "tail",
      "label": "Installed diagnostic worker tail",
      "path": "custom/ba-agent/tools/diagnostic_worker.py",
      "lines": 220
    },
    {
      "type": "lock_status",
      "label": "BA worker lock/process status",
      "path": "/tmp/librechat-ba-benchmark-worker.lock",
      "process_contains": "run_worker_once.sh"
    }
  ]
}
