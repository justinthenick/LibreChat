{
  "schema": 1,
  "name": "MSA-001 post-merge NAS deployment and skill-sync verification",
  "checks": [
    {
      "type": "lock_status",
      "label": "Autodeploy lock/process status",
      "path": "/tmp/librechat-autodeploy.lock",
      "process_contains": "autodeploy.sh"
    },
    {
      "type": "tail",
      "label": "Recent deployment event log",
      "path": "/volume1/docker/librechat-deploy-events.log",
      "lines": 200
    },
    {
      "type": "tail",
      "label": "Recent deployment log",
      "path": "/volume1/docker/librechat-deploy.log",
      "lines": 200
    },
    {
      "type": "tail",
      "label": "Last successful deployed SHA",
      "path": "/volume1/docker/librechat-deploy.last-success",
      "lines": 5
    },
    {
      "type": "tail",
      "label": "Live Synology LibreChat config",
      "path": "/volume1/docker/librechat/deploy/synology/librechat.yaml",
      "lines": 260
    },
    {
      "type": "skill_sync_status",
      "label": "Managed skills GitHub sync status",
      "source_id": "managed-skills"
    }
  ]
}
