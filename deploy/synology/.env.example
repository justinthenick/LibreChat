# =============================================================================
# LibreChat on Synology - private runtime configuration
# =============================================================================
# Copy this file to .env and keep .env private (chmod 600).
#
# Normal day-to-day settings live in the MANAGED SETTINGS sections below.
# Provider credentials are replace-only: the Admin Settings panel reports only
# CONFIGURED / NOT CONFIGURED and never returns their values.
# =============================================================================

# -----------------------------------------------------------------------------
# MANAGED SETTINGS - deployment address
# -----------------------------------------------------------------------------
NAS_HOST=192.168.1.5
LIBRECHAT_SCHEME=http
LIBRECHAT_PORT=3200
ADMIN_SETTINGS_PORT=3210
ADMIN_PANEL_URL=

# -----------------------------------------------------------------------------
# MANAGED SETTINGS - application behaviour
# -----------------------------------------------------------------------------
NO_INDEX=true
SEARCH=false
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# MANAGED SETTINGS - model catalogue
# -----------------------------------------------------------------------------
# The earlier Synology model pre-filter used ALLOWED_MODELS. It remains the
# canonical list: non-empty restricts OpenRouter to exactly these comma-separated
# model IDs; empty restores provider catalogue fetching.
ALLOWED_MODELS=

# -----------------------------------------------------------------------------
# MANAGED SETTINGS - authentication
# -----------------------------------------------------------------------------
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false

# -----------------------------------------------------------------------------
# AI PROVIDER CREDENTIALS - replace-only
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_KEY=
GEMINI_API_KEY=
OPENROUTER_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
TOGETHERAI_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_TOKEN=
DATABRICKS_API_KEY=
APIPIE_API_KEY=
ANYSCALE_API_KEY=
SHUTTLEAI_API_KEY=
UNIFY_API_KEY=
AZURE_API_KEY=
BEDROCK_AWS_BEARER_TOKEN=
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# AGENT CAPABILITY CREDENTIALS - replace-only / managed
# -----------------------------------------------------------------------------
# Initial managed web-search + page extraction provider used by librechat.yaml.
TAVILY_API_KEY=

# OCR service used by the enabled Agent OCR capability. LibreChat's OCR schema
# expects these dedicated service variables; configure them before invoking OCR.
OCR_API_KEY=
OCR_BASEURL=

# LibreChat hosted code-execution service. Configure the keys issued for the
# service you use. The default public base URLs match LibreChat's upstream env
# example and can be replaced from Admin Settings for a self-hosted endpoint.
LIBRECHAT_CODE_API_KEY=
LIBRECHAT_CODE_BASEURL=https://api.librechat.ai
CODE_ENV_API_KEY=
CODE_ENV_BASEURL=https://api.librechat.ai

# -----------------------------------------------------------------------------
# DEPLOYMENT INTEGRATIONS - replace-only
# -----------------------------------------------------------------------------
GITHUB_DEPLOY_STATUS_TOKEN=
GITHUB_TELEMETRY_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# Host recovery credential for the Synology Admin Settings panel. The normal
# browser flow uses a password-backed HttpOnly session after migration; this
# token is retained only for bootstrap/emergency recovery and is never shown.
ADMIN_SETTINGS_ACCESS_TOKEN=

# Private password for the internal PostgreSQL/pgvector RAG database.
RAG_DB_PASSWORD=

# -----------------------------------------------------------------------------
# LOCKED SECURITY MATERIAL
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# -----------------------------------------------------------------------------
# INTERNAL / FIXED VALUES
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=librechat
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat

# -----------------------------------------------------------------------------
# HTTPS / external-access reminder
# -----------------------------------------------------------------------------
# When LibreChat is genuinely served to the browser over HTTPS, set:
#   LIBRECHAT_SCHEME=https
#   SESSION_COOKIE_SECURE=true
# and set NAS_HOST to the browser-visible hostname used for LibreChat.
#
# The admin settings panel remains independently authenticated. Cloudflare
# Tunnel remains optional; a tunnel token alone is not an access policy.
