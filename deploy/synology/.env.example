# =============================================================================
# LibreChat on Synology - private runtime configuration
# =============================================================================
# Copy this file to .env and keep .env private (chmod 600).
#
# Normal day-to-day settings live in the MANAGED SETTINGS sections below.
# Secrets are replace-only. Locked security material should not be rotated as a
# routine settings change. DOMAIN_CLIENT / DOMAIN_SERVER are derived in Compose
# from scheme + host + port and therefore do not need to be maintained here.
#
# Optional helper:
#   python3 manage-env.py show
#   python3 manage-env.py validate
#   python3 manage-env.py set SEARCH true
#   python3 manage-env.py set-secret OPENROUTER_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# MANAGED SETTINGS - deployment address
# -----------------------------------------------------------------------------
NAS_HOST=192.168.1.5
LIBRECHAT_SCHEME=http
LIBRECHAT_PORT=3200

# Optional URL opened by LibreChat's admin-only "Admin panel" link.
# Leave blank until the Synology Admin Settings service is enabled.
ADMIN_PANEL_URL=

# -----------------------------------------------------------------------------
# MANAGED SETTINGS - application behaviour
# -----------------------------------------------------------------------------
NO_INDEX=true
SEARCH=false
SESSION_COOKIE_SECURE=false

# Initial single-user/LAN-friendly authentication settings.
# Disable registration after creating the intended accounts if desired.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false

# -----------------------------------------------------------------------------
# REPLACE-ONLY SECRETS
# Current values should never be displayed by a settings UI/manager.
# Store real values only in the private .env file.
# -----------------------------------------------------------------------------
OPENROUTER_KEY=
GITHUB_DEPLOY_STATUS_TOKEN=
GITHUB_TELEMETRY_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# LOCKED SECURITY MATERIAL
# Generate unique persistent values for long-term use. Do not rotate these as a
# routine settings change because doing so can invalidate sessions/credentials.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# -----------------------------------------------------------------------------
# INTERNAL / FIXED VALUES
# Normally do not edit these through the settings manager.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=librechat
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat

# -----------------------------------------------------------------------------
# HTTPS / external-access reminder
# -----------------------------------------------------------------------------
# When LibreChat is genuinely served to the browser over HTTPS, set:
#   LIBRECHAT_SCHEME=https
#   SESSION_COOKIE_SECURE=true
# and set NAS_HOST to the browser-visible hostname used for LibreChat.
#
# Cloudflare Tunnel remains optional. A tunnel token alone is not an access
# policy; keep remote access protected separately.
