# Synology/NAS deployment settings
COMPOSE_PROJECT_NAME=librechat
NAS_HOST=192.168.1.5
LIBRECHAT_SCHEME=http
LIBRECHAT_PORT=3200

# LibreChat application settings
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://192.168.1.5:3200
DOMAIN_SERVER=http://192.168.1.5:3200
NO_INDEX=true
SEARCH=false
SESSION_COOKIE_SECURE=false

# Initial single-user/LAN-friendly authentication settings.
# Disable registration after creating the first account if desired.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false

# OpenRouter provider. Populate only in the private NAS .env file.
OPENROUTER_KEY=

# Stable LibreChat releases require persistent authentication/encryption secrets.
# Generate unique values in the private NAS .env file; never commit real secrets.
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Optional deployment feedback to GitHub commit statuses.
# Use a fine-grained PAT scoped only to this repository with
# Repository permissions -> Commit statuses: Read and write.
# Store the real token only in the private NAS .env file.
GITHUB_DEPLOY_STATUS_TOKEN=
