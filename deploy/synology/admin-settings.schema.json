    {"key":"GITHUB_DEPLOY_STATUS_TOKEN","label":"GitHub deployment status token","group":"integrations","class":"replace_only_secret","control":"secret","required":false,"restart":"none","services":[]},
    {"key":"GITHUB_TELEMETRY_TOKEN","label":"GitHub telemetry token","group":"integrations","class":"replace_only_secret","control":"secret","required":false,"restart":"none","services":[]},
    {"key":"CLOUDFLARE_TUNNEL_TOKEN","label":"Cloudflare tunnel token","group":"integrations","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["cloudflared"]},

    {"key":"ADMIN_SETTINGS_ACCESS_TOKEN","label":"Admin settings recovery token","group":"security","class":"replace_only_secret","control":"secret","required":false,"ui_hidden":true,"restart":"none","services":[],"description":"Host recovery credential retained for bootstrap/emergency access. Normal browser login uses a password-backed session."},
    {"key":"RAG_DB_PASSWORD","label":"RAG database password","group":"security","class":"locked_secret","ui_hidden":true,"description":"Private PostgreSQL/pgvector credential. Rotate only with a coordinated database credential change."},
    {"key":"JWT_SECRET","label":"JWT secret","group":"security","class":"locked_secret","ui_hidden":true},
    {"key":"JWT_REFRESH_SECRET","label":"JWT refresh secret","group":"security","class":"locked_secret","ui_hidden":true},
    {"key":"CREDS_KEY","label":"Credential encryption key","group":"security","class":"locked_secret","ui_hidden":true},
