    {"key":"OCR_API_KEY","label":"OCR service API key","group":"capabilities","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"],"description":"Credential used by LibreChat's enabled OCR capability with the configured Mistral OCR strategy."},
    {"key":"OCR_BASEURL","label":"OCR service base URL","group":"capabilities","class":"editable","control":"text","required":false,"validation":{"type":"url","schemes":["http","https"],"allow_empty":true},"restart":"recreate","services":["api"],"description":"Base URL for the OCR service. Leave empty until the OCR service endpoint is selected/configured."},
