{
  "schema": 5,
  "title": "LibreChat Synology Admin Settings",
  "groups": [
    {"id": "address", "label": "Address and access"},
    {"id": "application", "label": "Application behaviour"},
    {"id": "models", "label": "Model catalogue"},
    {"id": "authentication", "label": "Authentication"},
    {"id": "providers", "label": "AI provider credentials"},
    {"id": "integrations", "label": "Deployment integrations"},
    {"id": "security", "label": "Locked security material"},
    {"id": "internal", "label": "Internal values"}
  ],
  "settings": [
    {"key":"NAS_HOST","label":"LibreChat host","group":"address","class":"editable","control":"text","validation":{"type":"host"},"restart":"recreate","services":["api"],"description":"Browser-visible hostname or IP address used to construct LibreChat URLs."},
    {"key":"LIBRECHAT_SCHEME","label":"LibreChat scheme","group":"address","class":"editable","control":"select","options":["http","https"],"restart":"recreate","services":["api"]},
    {"key":"LIBRECHAT_PORT","label":"LibreChat host port","group":"address","class":"editable","control":"number","validation":{"type":"integer","minimum":1,"maximum":65535},"restart":"recreate","services":["api"]},
    {"key":"ADMIN_SETTINGS_PORT","label":"Admin settings port","group":"address","class":"editable","control":"number","required":false,"ui_hidden":true,"validation":{"type":"integer","minimum":1,"maximum":65535},"restart":"recreate","services":["admin-settings"],"description":"LAN port used by the Synology Admin Settings panel. Change with the host CLI because changing it from the panel would interrupt the active session."},
    {"key":"ADMIN_PANEL_URL","label":"Synology admin panel URL","group":"address","class":"editable","control":"text","required":false,"validation":{"type":"url","schemes":["http","https"],"allow_empty":true},"restart":"recreate","services":["api"],"description":"URL exposed through LibreChat's admin-only Admin panel link."},
    {"key":"DOMAIN_CLIENT","label":"Client URL","group":"address","class":"derived","derive":"${LIBRECHAT_SCHEME}://${NAS_HOST}:${LIBRECHAT_PORT}","restart":"recreate","services":["api"]},
    {"key":"DOMAIN_SERVER","label":"Server URL","group":"address","class":"derived","derive":"${LIBRECHAT_SCHEME}://${NAS_HOST}:${LIBRECHAT_PORT}","restart":"recreate","services":["api"]},

    {"key":"NO_INDEX","label":"Prevent search-engine indexing","group":"application","class":"editable","control":"boolean","restart":"recreate","services":["api"]},
    {"key":"SEARCH","label":"Enable LibreChat search integration","group":"application","class":"editable","control":"boolean","restart":"recreate","services":["api"]},
    {"key":"SESSION_COOKIE_SECURE","label":"Secure session cookie","group":"application","class":"editable","control":"boolean","restart":"recreate","services":["api"],"warning":"Enable when the browser reaches LibreChat over HTTPS."},

    {"key":"ALLOWED_MODELS","label":"Allowed OpenRouter models / pre-filter","group":"models","class":"editable","control":"text","required":false,"restart":"recreate","services":["api"],"description":"Comma-separated OpenRouter model IDs. A non-empty list restricts the catalogue to exactly these models; clear the field to fetch the full OpenRouter catalogue. Existing ALLOWED_MODELS values from the earlier pre-filter are preserved."},

    {"key":"ALLOW_EMAIL_LOGIN","label":"Allow email login","group":"authentication","class":"editable","control":"boolean","restart":"recreate","services":["api"]},
    {"key":"ALLOW_REGISTRATION","label":"Allow new registrations","group":"authentication","class":"editable","control":"boolean","restart":"recreate","services":["api"],"warning":"Normally disable after the intended accounts have been created."},
    {"key":"ALLOW_SOCIAL_LOGIN","label":"Allow social login","group":"authentication","class":"editable","control":"boolean","restart":"recreate","services":["api"]},
    {"key":"ALLOW_SOCIAL_REGISTRATION","label":"Allow social registration","group":"authentication","class":"editable","control":"boolean","restart":"recreate","services":["api"]},
    {"key":"ALLOW_UNVERIFIED_EMAIL_LOGIN","label":"Allow unverified email login","group":"authentication","class":"editable","control":"boolean","restart":"recreate","services":["api"]},
    {"key":"ALLOW_PASSWORD_RESET","label":"Allow password reset","group":"authentication","class":"editable","control":"boolean","restart":"recreate","services":["api"]},

    {"key":"OPENAI_API_KEY","label":"OpenAI API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"ANTHROPIC_API_KEY","label":"Anthropic API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"GOOGLE_KEY","label":"Google / Gemini chat API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"GEMINI_API_KEY","label":"Gemini tools / image API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"],"description":"Optional dedicated Gemini tool key. GOOGLE_KEY remains the shared Google chat endpoint credential."},
    {"key":"OPENROUTER_KEY","label":"OpenRouter API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api","rag_api"]},
    {"key":"DEEPSEEK_API_KEY","label":"DeepSeek API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"MISTRAL_API_KEY","label":"Mistral API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
