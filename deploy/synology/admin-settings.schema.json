    {"key":"FIREWORKS_API_KEY","label":"Fireworks API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"HUGGINGFACE_TOKEN","label":"Hugging Face token","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"DATABRICKS_API_KEY","label":"Databricks API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"APIPIE_API_KEY","label":"APIpie API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"ANYSCALE_API_KEY","label":"Anyscale API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"SHUTTLEAI_API_KEY","label":"ShuttleAI API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"UNIFY_API_KEY","label":"Unify API key","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"AZURE_API_KEY","label":"Azure OpenAI API key (legacy env)","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"BEDROCK_AWS_BEARER_TOKEN","label":"AWS Bedrock bearer token","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
    {"key":"BEDROCK_AWS_ACCESS_KEY_ID","label":"AWS Bedrock access key ID","group":"providers","class":"replace_only_secret","control":"secret","required":false,"restart":"recreate","services":["api"]},
